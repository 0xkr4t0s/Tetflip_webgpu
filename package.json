{
  "name": "tetflip-webgpu",
  "private": true,
  "version": "2.0.0",
  "description": "Real-time TETFLIP liquid simulation (Ando, Thuerey & Wojtan 2013) on the GPU with WebGPU",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "node scripts/gpu-check.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "record": "node scripts/record-gif.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "gifenc": "^1.0.3",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "lil-gui": "^0.21.0"
  }
}
